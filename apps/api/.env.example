# --- Application ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Base de données (Neon PostgreSQL — behouse_db) ---
# Connexion "pooled" : utilisée par l'application au runtime.
DATABASE_URL=
# Connexion directe (sans pooling) : requise par Prisma pour les migrations
# (les migrations passent mal par un pooler type pgbouncer).
DIRECT_DATABASE_URL=

# --- Stockage fichiers (Neon Storage, compatible S3) ---
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET_NAME=behouse_storage

# --- Authentification ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# URL du frontend, utilisée pour la redirection après connexion Google.
FRONTEND_URL=http://localhost:3000

# --- Paiement (CinetPay) ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_NOTIFY_URL=http://localhost:3001/api/payments/cinetpay/webhook

# --- Commission plateforme ---
DEFAULT_COMMISSION_RATE=0.10
